{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "personal-finance",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The SPA build is served by the asset server; only /api/* reaches the Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // Connects as pf_api (schema `app`), sslmode verify-full, caching disabled. `wrangler dev` uses
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE from .env instead (pf_api_dev, `app_dev`).
  // Credentials: `pnpm --filter @pf/api db:credentials`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5f7a912dadc44a67bd0f2e6cc91300e8",
    },
  ],
  // Per Cloudflare location and eventually consistent: a brake against brute force, not accounting.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Public values only. Secrets go through `wrangler secret put` (and .dev.vars locally).
  "vars": {
    "SUPABASE_URL": "https://qjzsepekcqqosgkbwuga.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_KIatDZeudHIAAh8B5yn9VQ_hY-s-pR5",
    // Comma-separated origins allowed besides the Worker's own (e.g. the Vite dev server).
    "APP_EXTRA_ORIGINS": "",
  },
}
