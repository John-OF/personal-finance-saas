{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "personal-finance",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The SPA build is served by the asset server; only /api/* reaches the Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // Per Cloudflare location and eventually consistent: a brake against brute force, not accounting.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Public values only. Secrets go through `wrangler secret put` (and .dev.vars locally).
  "vars": {
    "SUPABASE_URL": "https://qjzsepekcqqosgkbwuga.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_KIatDZeudHIAAh8B5yn9VQ_hY-s-pR5",
    // Comma-separated origins allowed besides the Worker's own (e.g. the Vite dev server).
    "APP_EXTRA_ORIGINS": "",
  },
}
